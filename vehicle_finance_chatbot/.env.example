# --- LLM provider (OpenAI-compatible) ---
# Options: vllm | ollama | mock
LLM_PROVIDER=mock
LLM_BASE_URL=http://localhost:8000/v1
LLM_API_KEY=local-dev-key
LLM_MODEL=Qwen2.5-72B-Instruct-AWQ
LLM_TEMPERATURE=0.1

# --- Embeddings ---
EMBEDDING_PROVIDER=hash
# Set to "sentence-transformers" to use the real model (heavy dependency).
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# --- Vector store ---
# Options: faiss | qdrant
VECTORSTORE=faiss
QDRANT_URL=http://localhost:6333

# --- Database ---
DATABASE_URL=sqlite:///./vehicle_finance.db

# --- Security / logging ---
PII_LOG_MASKING=true
AUDIT_LOG_PATH=./audit.log

# --- LiteLLM Gateway ---
LLM_GATEWAY_ENABLED=false
LITELLM_BASE_URL=http://localhost:4000
LITELLM_MASTER_KEY=sk-master-dev-1234
LITELLM_VIRTUAL_KEY=sk-app-dev-1234
LITELLM_MODEL_LARGE=vehicle-finance-large
LITELLM_MODEL_SMALL=vehicle-finance-small
LITELLM_MODEL_GUARD=vehicle-finance-guard
LLM_REQUEST_TIMEOUT_S=30
ENABLE_CLOUD_FALLBACK=false

# --- Server ---
APP_HOST=0.0.0.0
APP_PORT=8080
